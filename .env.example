# Docket reads these from the process environment. `make serve` loads this file
# (as .env) for you. Run `make env` to create .env with a random ingest token.
# Nothing here is needed to run the tests or the seeded demo.

# --- Docket's own tokens: you make these up --------------------------------
DOCKET_INGEST_TOKEN=change-me   # bearer token Claude Code sends to /v1/* and /hooks/*. Required outside a laptop.
DOCKET_API_TOKEN=               # bearer token for write routes (run, threshold, seed). Empty = open, dev only.

# --- External services: all optional, each unlocks one integration ---------
GITHUB_TOKEN=                   # live PRs, commit statuses, CI coverage artifacts. Without it: replay/demo only.
FRESHSERVICE_API_KEY=           # also set freshservice.enabled + domain in config.json. Without it: dry-run to out/.
ANTHROPIC_API_KEY=              # the advisory board brief only. Without it: template brief. Never affects the decision.

# --- Runtime ------------------------------------------------------------------
DOCKET_DB=./docket.sqlite       # SQLite file, relative to the repo root
DOCKET_MODE=live                # live | replay (replay: POST /run/{pr} uses demo/seed before GitHub)
DOCKET_SIMULATE_COVERAGE=       # 1 = invent deterministic coverage when CI has none, labelled "simulated"
DOCKET_REPLAY_WRITES=           # 1 = let replayed runs write to Freshservice and GitHub too
DOCKET_CONFIG=                  # path to an alternative config.json
